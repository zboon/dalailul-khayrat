#!/usr/bin/env bash
# Refuse a push to a protected branch unless it was explicitly approved.
#
# Second layer, and the one that holds when the first does not. The Claude Code
# PreToolUse hook in .claude/ only loads for sessions that started with that
# directory present, so a session which creates it is not itself covered. Git
# runs this one regardless of who or what is pushing.
#
# To push to main on purpose:  MAIN_PUSH_OK=1 git push origin main
# The variable has to be typed into the command, so it cannot happen absently —
# and in a Claude session it appears in the command the owner is approving.
#
# Enable in a clone with:  git config core.hooksPath .githooks
set -uo pipefail
PROTECTED='^refs/heads/(main|master)$'

# index.html and sw.js are generated from src/; a stale pair would ship old code.
if [ -f build.js ] && command -v node >/dev/null 2>&1 && ! node build.js --check >/dev/null 2>&1; then
  echo "pre-push: index.html / sw.js are out of date with src/ — run: node build.js" >&2
  exit 1
fi

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if printf '%s' "$remote_ref" | grep -Eq "$PROTECTED"; then
    if [ "${MAIN_PUSH_OK:-}" = "1" ]; then
      echo "pre-push: approved push to ${remote_ref#refs/heads/} (MAIN_PUSH_OK=1)." >&2
    else
      cat >&2 <<MSG
pre-push: refusing to push to ${remote_ref#refs/heads/}.

Anything on that branch is live to people reciting from the app within a
minute, so it needs a deliberate decision, not a reflex.

If this was meant, re-run it as:
    MAIN_PUSH_OK=1 git push ...
MSG
      exit 1
    fi
  fi
done
exit 0
